    "group/lab": {
      "orientation": "inherit",
      "modules": [
        "custom/docker",
        "custom/kvm",
        "custom/updates"
      ]
    },
    "group/addresses": {
      "orientation": "inherit",
      "drawer": {
        "transition-duration": 150
      },
      "modules": [
        "custom/local_ip",
        "custom/public_ip"
      ]
    },
    "group/operations": {
      "orientation": "inherit",
      "drawer": {
        "transition-duration": 150
      },
      "modules": [
        "custom/local_ip",
        "custom/public_ip",
        "custom/settarget",
        "group/lab"
      ]
    },
    "group/system": {
      "orientation": "inherit",
      "drawer": {
        "transition-duration": 150
      },
      "modules": [
        "custom/control",
        "network",
        "bluetooth",
        "pulseaudio",
        "battery",
        "custom/power"
      ]
    },
