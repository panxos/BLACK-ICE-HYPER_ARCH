[
  {
    "name": "desktop",
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 0,
    "modules-left": [
      "custom/launcher",
      "custom/player",
      "custom/weather"
    ],
    "modules-center": [
      "hyprland/workspaces"
    ],
    "modules-right": [
      "network",
      "bluetooth",
      "pulseaudio",
      "battery",
      "clock",
      "custom/control",
      "custom/power",
      "tray"
    ],
    "custom/launcher": {
      "format": "󰣇",
      "tooltip": false,
      "on-click": "wofi --show drun --allow-images"
    },
    "hyprland/workspaces": {
      "format": "{icon}",
      "on-click": "activate",
      "persistent-workspaces": {
        "*": 5
      },
      "format-icons": {
        "default": "◇",
        "empty": "◇",
        "persistent": "◇",
        "active": "◆",
        "urgent": "!"
      },
      "tooltip": true,
      "tooltips": {
        "default": "Escritorio {name}: {windows}",
        "empty": "Escritorio {name}"
      }
    },
    "network": {
      "format-wifi": "󰤨",
      "format-ethernet": "󰈀",
      "format-disconnected": "󰤭",
      "tooltip-format": "{ifname} · {essid}",
      "on-click": "~/.local/bin/black-ice-control network"
    },
    "bluetooth": {
      "format": "󰂯",
      "format-disabled": "󰂲",
      "format-connected": "󰂱",
      "tooltip-format": "{status}",
      "on-click": "~/.local/bin/black-ice-control bluetooth"
    },
    "pulseaudio": {
      "format": "󰕾 {volume}%",
      "format-muted": "󰝟",
      "on-click": "~/.local/bin/black-ice-control",
      "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
    "battery": {
      "format": "{capacity}%",
      "format-charging": "󰂄 {capacity}%",
      "states": {
        "warning": 25,
        "critical": 10
      }
    },
    "clock": {
      "format": "{:%H:%M}",
      "tooltip-format": "{:L%A, %d de %B}"
    },
    "custom/control": {
      "format": "",
      "tooltip-format": "Ajustes · clic derecho: notificaciones",
      "on-click": "~/.local/bin/black-ice-control",
      "on-click-right": "swaync-client -t -sw"
    },
    "custom/power": {
      "format": "󰐥",
      "tooltip": false,
      "on-click": "~/.local/bin/black-ice-control session"
    },
    "tray": {
      "icon-size": 14,
      "spacing": 8
    },
    "custom/player": {
      "exec": "~/.local/bin/black-ice-waybar player",
      "return-type": "json",
      "interval": 5,
      "format": "{}",
      "escape": true,
      "tooltip": true,
      "max-length": 24,
      "on-click": "playerctl play-pause"
    },
    "custom/weather": {
      "exec": "~/.local/bin/black-ice-waybar weather",
      "return-type": "json",
      "interval": 1800,
      "format": "{}",
      "escape": true,
      "tooltip": true,
      "max-length": 18
    },
    "group/connectivity": {
      "orientation": "inherit",
      "drawer": {
        "transition-duration": 150
      },
      "modules": [
        "network",
        "bluetooth"
      ]
    },
    "group/media": {
      "orientation": "inherit",
      "drawer": {
        "transition-duration": 150
      },
      "modules": [
        "clock",
        "custom/player",
        "custom/weather"
      ]
    },
    "custom/docker": {
      "exec": "~/.local/bin/black-ice-waybar docker",
      "return-type": "json",
      "interval": 15,
      "format": "{}",
      "escape": true,
      "tooltip": true,
      "max-length": 12,
      "exec-if": "command -v docker >/dev/null 2>&1",
      "hide-empty-text": true,
      "on-click": "~/.config/bin/docker_menu"
    },
    "custom/kvm": {
      "exec": "~/.local/bin/black-ice-waybar kvm",
      "return-type": "json",
      "interval": 15,
      "format": "{}",
      "escape": true,
      "tooltip": true,
      "max-length": 12,
      "exec-if": "command -v virsh >/dev/null 2>&1",
      "hide-empty-text": true,
      "on-click": "~/.config/bin/kvm_menu"
    },
    "custom/updates": {
      "exec": "~/.local/bin/black-ice-waybar updates",
      "return-type": "json",
      "interval": 1800,
      "format": "{}",
      "escape": true,
      "tooltip": true,
      "max-length": 12
    },
    "custom/local_ip": {
      "exec": "~/.local/bin/black-ice-waybar local",
      "return-type": "json",
      "interval": 10,
      "format": "{}",
      "escape": true,
      "tooltip": true,
      "max-length": 24,
      "on-click-right": "~/.local/bin/black-ice-waybar copy local"
    },
    "custom/public_ip": {
      "exec": "~/.local/bin/black-ice-waybar public",
      "return-type": "json",
      "interval": 60,
      "format": "{}",
      "escape": true,
      "tooltip": true,
      "max-length": 24,
      "on-click-right": "~/.local/bin/black-ice-waybar copy public"
    },
    "custom/vpn": {
      "exec": "~/.local/bin/black-ice-waybar vpn",
      "return-type": "json",
      "interval": 5,
      "format": "{}",
      "escape": true,
      "tooltip": true,
      "max-length": 24,
      "on-click-right": "~/.local/bin/black-ice-waybar copy vpn"
    },
    "custom/settarget": {
      "exec": "~/.local/bin/black-ice-waybar target",
      "return-type": "json",
      "interval": 3,
      "format": "{}",
      "escape": true,
      "tooltip": true,
      "max-length": 28,
      "on-click-right": "~/.local/bin/black-ice-waybar copy target",
      "on-click": "~/.local/bin/black-ice-waybar choose-target"
    },
    "custom/privacy": {
      "exec": "~/.local/bin/black-ice-privacy status --waybar",
      "return-type": "json",
      "interval": 3,
      "format": "{}",
      "escape": true,
      "on-click": "~/.local/bin/black-ice-privacy toggle",
      "on-click-right": "~/.local/bin/black-ice-privacy menu",
      "tooltip": true
    },
    "group/lab": {
      "orientation": "inherit",
      "modules": [
        "custom/docker",
        "custom/kvm",
        "custom/updates"
      ]
    },
    "group/addresses": {
      "orientation": "inherit",
      "drawer": {
        "transition-duration": 150
      },
      "modules": [
        "custom/local_ip",
        "custom/public_ip"
      ]
    },
    "group/operations": {
      "orientation": "inherit",
      "drawer": {
        "transition-duration": 150
      },
      "modules": [
        "custom/local_ip",
        "custom/public_ip",
        "custom/settarget",
        "group/lab"
      ]
    },
    "group/system": {
      "orientation": "inherit",
      "drawer": {
        "transition-duration": 150
      },
      "modules": [
        "custom/control",
        "network",
        "bluetooth",
        "pulseaudio",
        "battery",
        "custom/power"
      ]
    },
    "fixed-center": true
  },
  {
    "name": "operations",
    "layer": "top",
