#!/bin/bash
set -euo pipefail

DRY_RUN=false
NO_PULL=false
REPO_DIR="${BLACK_ICE_REPO:-}"
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
REPO_PATH_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/black-ice/repository"
SAVED_REPO=""
if [[ -r "$REPO_PATH_FILE" ]]; then
    IFS= read -r SAVED_REPO < "$REPO_PATH_FILE" || true
fi

while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=true ;;
        --no-pull) NO_PULL=true ;;
        --no-restart) : ;;
        --repo) REPO_DIR="${2:?Falta la ruta del repositorio}"; shift ;;
        --help|-h)
            printf '%s\n' 'Uso: dotfiles-update [--repo RUTA] [--no-pull] [--dry-run] [--no-restart]'
            exit 0 ;;
        *) printf 'Opción no admitida: %s\n' "$1" >&2; exit 2 ;;
    esac
    shift
done

if [[ -z "$REPO_DIR" ]]; then
    for candidate in "$SCRIPT_DIR/../.." "$PWD" "$SAVED_REPO" "$HOME/BLACK-ICE_ARCH"; do
        if [[ -f "$candidate/dotfiles/bin/hyprland-migrate" ]]; then
            REPO_DIR="$candidate"
            break
        fi
    done
fi
[[ -n "$REPO_DIR" ]] || { printf '%s\n' 'Indica el repositorio con --repo RUTA.' >&2; exit 1; }
REPO_DIR=$(cd -- "$REPO_DIR" && pwd -P)
MIGRATOR="$REPO_DIR/dotfiles/bin/hyprland-migrate"
[[ -f "$MIGRATOR" ]] || { printf '%s\n' 'El repositorio no contiene la migración.' >&2; exit 1; }
if [[ -L "${XDG_CONFIG_HOME:-$HOME/.config}/hypr" || -L "${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.conf" ]]; then
    printf '%s\n' 'La configuración Hyprland usa un symlink. Crea una copia local antes de actualizar.' >&2
    exit 1
fi

if [[ "$NO_PULL" == false ]]; then
    if [[ "$DRY_RUN" == true ]]; then
        printf '%s\n' '[SIMULACIÓN] git pull --ff-only; no se descargan cambios.'
    else
        git -C "$REPO_DIR" pull --ff-only
        exec bash "$REPO_DIR/dotfiles/bin/dotfiles-update" --repo "$REPO_DIR" --no-pull
    fi
fi

if [[ "$DRY_RUN" == true ]]; then
    python3 "$MIGRATOR" --dry-run
    printf '%s\n' '[SIMULACIÓN] Se publicarían los comandos de actualización y migración.'
    exit 0
fi

python3 "$MIGRATOR"
install -d "$HOME/.local/bin"
for name in hyprland-migrate dotfiles-update dotfiles-rollback black-ice-update; do
    install -m 755 "$REPO_DIR/dotfiles/bin/$name" "$HOME/.local/bin/$name"
done
install -d -m 700 "$(dirname -- "$REPO_PATH_FILE")"
(umask 077; printf '%s\n' "$REPO_DIR" > "$REPO_PATH_FILE")
printf '%s\n' 'Actualización terminada. Configuraciones personales conservadas; no se reinició la sesión.'
