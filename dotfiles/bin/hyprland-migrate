#!/usr/bin/env python3
"""Migra la configuración instalada sin reemplazar ajustes personales."""

import argparse
import fcntl
import glob
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
from datetime import datetime, timezone
from pathlib import Path

CONVERTER_REV = "4d69a9b52ce09c9b113a1642e537cd2fa4754a09"
GENERATED = {"monitors.conf", "vm-performance.conf"}
MARKER = "# BLACK_ICE_LUA_SYNC_V1"


class MigrationError(Exception):
    pass


def digest(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def run(command: list[str], **kwargs: object) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(command, capture_output=True, text=True, timeout=120, check=False, **kwargs)
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise MigrationError(f"No se pudo ejecutar {command[0]}: {exc}") from exc


def hyprland_version(binary: str) -> tuple[int, int]:
    result = run([binary, "--version"])
    match = re.search(r"Hyprland\s+(\d+)\.(\d+)", result.stdout)
    if result.returncode or not match:
        raise MigrationError("No se pudo verificar la versión de Hyprland.")
    return int(match[1]), int(match[2])


def converter_path(explicit: str | None, work: Path, dry_run: bool) -> str:
    if explicit:
        return explicit
    installed = shutil.which("hyprlang2lua")
    if installed:
        return installed
    cached = Path.home() / ".local/lib/black-ice" / f"hyprlang2lua-{CONVERTER_REV}"
    if cached.is_file():
        return str(cached)
    if dry_run or not shutil.which("go"):
        raise MigrationError("Falta hyprlang2lua. Instala con paru -S hyprlang2lua y repite.")
    print("Compilando el conversor desde una revisión fija; la configuración permanece local.")
    env = dict(os.environ, GOBIN=str(work / "bin"), GOMODCACHE=str(work / "go-mod"), GOTOOLCHAIN="local")
    result = run(["go", "install", f"github.com/EIonTusk/hyprlang2lua/cmd/hyprlang2lua@{CONVERTER_REV}"], env=env)
    if result.returncode:
        raise MigrationError("No se pudo compilar hyprlang2lua. Instala el paquete de AUR y repite.")
    cached.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(work / "bin/hyprlang2lua", cached)
    return str(cached)


def normalize_sections(text: str) -> str:
    lines = []
    for line in text.splitlines():
        if line.strip() == "exec-once = bash -c 'sleep 8 && [ ! -f ~/.config/waybar/themes/Horus-Cyber/preview.png ] && ~/.config/bin/gen_theme_previews'":
            continue
        remaining = line.strip()
        openings = []
        while match := re.match(r"^([\w:-]+)\s*\{\s*(.*)$", remaining):
            openings.append(match[1] + " {")
            remaining = match[2]
        closing = re.search(r"(?:\s*})+\s*$", remaining) if openings else None
        if not closing:
            lines.append(line)
            continue
        value = remaining[:closing.start()].strip()
        count = closing[0].count("}")
        if "{" in value or "}" in value or count > len(openings):
            raise MigrationError("Bloque compacto ambiguo; separa sus llaves en líneas antes de migrar.")
        lines.extend(openings)
        if value:
            lines.append(value)
        lines.extend("}" for _ in range(count))
    return "\n".join(lines) + "\n"


def convert(binary: str, text: str) -> str:
    result = run([binary, "--check", "--no-merge"], input=normalize_sections(text))
    if result.returncode or "-- TODO: manual review" in result.stdout:
        details = " ".join(result.stderr.strip().splitlines()[:3])[:500]
        raise MigrationError("Conversión incompleta: hay directivas que requieren revisión manual. " + details)
    if not result.stdout.strip():
        raise MigrationError("El conversor produjo una configuración vacía.")
    return "\n".join(line for line in result.stdout.splitlines()
                     if not line.startswith("-- Generated by hyprlang2lua.")) + "\n"


def verify(binary: str, candidate: Path) -> None:
    env = dict(os.environ)
    env.pop("HYPRLAND_INSTANCE_SIGNATURE", None)
    env.pop("WAYLAND_DISPLAY", None)
    result = run([binary, "--verify-config", "-c", str(candidate)], env=env)
    output = result.stdout + "\n" + result.stderr
    if result.returncode or not re.search(r"^config ok\s*$", output, re.MULTILINE):
        errors = [line[:250] for line in output.splitlines() if any(word in line.lower() for word in ("error", "unknown config", "invalid"))]
        raise MigrationError("Hyprland rechazó el candidato. " + " ".join(errors[:3]))


class Sources:
    def __init__(self, root: Path) -> None:
        self.root = root
        self.originals: dict[Path, bytes] = {}
        self.variables: dict[str, str] = {}
        self.modules: dict[Path, str] = {}
        self.total = 0

    def expand(self, path: Path, stack: tuple[Path, ...] = ()) -> str:
        absolute = Path(os.path.abspath(path))
        if not absolute.is_relative_to(self.root) or absolute.suffix != ".conf":
            raise MigrationError(f"Inclusión fuera de la carpeta Hyprland o formato no admitido: {absolute.name}")
        if absolute in stack or len(stack) > 20:
            raise MigrationError("Inclusión cíclica o demasiado profunda.")
        data = absolute.read_bytes()
        self.total += len(data)
        if self.total > 4 * 1024 * 1024 or len(self.originals) > 256:
            raise MigrationError("La configuración excede los límites de conversión.")
        self.originals[absolute] = data
        text = data.decode("utf-8")
        if stack and absolute.parent == self.root and absolute.name in GENERATED:
            meaningful = "\n".join(line for line in text.splitlines() if not line.lstrip().startswith("#"))
            if re.search(r"\$[A-Za-z_]|^\s*source\s*=", meaningful, re.MULTILINE):
                raise MigrationError(f"{absolute.name} contiene variables o inclusiones personalizadas; requiere revisión.")
            token = self.modules.setdefault(absolute, f"BLACK_ICE_NATIVE_MODULE_{len(self.modules)}")
            return f"# {token}\n"
        lines = []
        for line in text.splitlines():
            definition = re.match(r"^\s*\$([\w-]+)\s*=\s*(.*)$", line)
            if definition:
                self.variables[definition[1]] = definition[2].strip()
            source = re.match(r"^\s*source\s*=\s*(.+?)\s*$", line)
            if not source:
                lines.append(line)
                continue
            pattern = source[1].split(" #", 1)[0].strip()
            pattern = re.sub(r"\$([\w-]+)", lambda m: self.variables.get(m[1], os.environ.get(m[1], m[0])), pattern)
            if "$" in pattern:
                raise MigrationError("No se pudo resolver una variable de source.")
            expanded = Path(pattern).expanduser()
            if not expanded.is_absolute():
                expanded = absolute.parent / expanded
            matches = sorted(glob.glob(str(expanded)))
            if not matches:
                raise MigrationError(f"Inclusión inexistente: {pattern}")
            lines.extend(self.expand(Path(match), stack + (absolute,)) for match in matches)
        return "\n".join(lines) + "\n"


def staged_config(root: Path, work: Path, converter: str) -> tuple[dict[Path, bytes], dict[Path, bytes], Path]:
    sources = Sources(root)
    text = convert(converter, sources.expand(root / "hyprland.conf"))
    changes = {}
    candidate_text = text
    for index, (source, token) in enumerate(sources.modules.items()):
        target = source.with_suffix(".lua")
        content = convert(converter, sources.originals[source].decode("utf-8"))
        if target.exists() or target.is_symlink():
            if source.name == "monitors.conf" and target.is_file() and target.read_text().startswith("-- Generated by nwg-displays"):
                # nwg-displays genera ambos formatos; conservar el Lua existente.
                text = text.replace(f"-- {token}", f"dofile({json.dumps(str(target))})")
                candidate_text = candidate_text.replace(f"-- {token}", f"dofile({json.dumps(str(target))})")
                sources.originals[target] = target.read_bytes()
                continue
            raise MigrationError(f"Ya existe {target.name}; no se reemplaza.")
        staged = work / f"module-{index}.lua"
        staged.write_text(content)
        changes[target] = content.encode()
        text = text.replace(f"-- {token}", f"dofile({json.dumps(str(target))})")
        candidate_text = candidate_text.replace(f"-- {token}", f"dofile({json.dumps(str(staged))})")
    changes[root / "hyprland.lua"] = text.encode()
    candidate = work / "hyprland.lua"
    candidate.write_text(candidate_text)
    return changes, sources.originals, candidate


def state_root() -> Path:
    return Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "black-ice/hyprland-migrations"


def commit(changes: dict[Path, bytes], originals: dict[Path, bytes], work: Path, root: Path) -> Path:
    for path, data in originals.items():
        if path.read_bytes() != data:
            raise MigrationError("La configuración cambió durante la validación; repite la migración.")
    snapshot = state_root() / (datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S") + "-" + work.name)
    snapshot.mkdir(parents=True, mode=0o700)
    snapshot.chmod(0o700)
    for index, (path, data) in enumerate(originals.items()):
        backup = snapshot / f"source-{index}.conf"
        backup.write_bytes(data)
        backup.chmod(0o600)
    records = []
    for index, (path, data) in enumerate(changes.items()):
        record = {"path": str(path), "after": digest(data), "before": None,
                  "mode": 0o755 if path.name == "hyprland-migrate" else 0o600}
        if path.exists() or path.is_symlink():
            if path.name.endswith(".lua"):
                raise MigrationError(f"Apareció {path.name} durante la migración; se conserva.")
            backup = snapshot / f"original-{index}"
            shutil.copyfile(path, backup)
            backup.chmod(0o600)
            record.update(before=backup.name, mode=path.stat().st_mode & 0o777,
                          link=os.readlink(path) if path.is_symlink() else None)
        records.append(record)
    manifest = {"config_dir": str(root), "files": records, "status": "pending"}
    manifest_path = snapshot / "manifest.json"
    manifest_path.write_text(json.dumps(manifest, indent=2))
    manifest_path.chmod(0o600)
    published = []
    try:
        for index, record in enumerate(records):
            target = Path(record["path"])
            target.parent.mkdir(parents=True, exist_ok=True)
            staged = work / f"publish-{index}"
            staged.write_bytes(changes[target])
            staged.chmod(record["mode"])
            if record["before"] is None:
                os.link(staged, target)
            else:
                os.replace(staged, target)
            published.append(record)
    except OSError as exc:
        for record in reversed(published):
            restore(record, snapshot, work)
        manifest["status"] = "reverted"
        manifest_path.write_text(json.dumps(manifest, indent=2))
        raise MigrationError(f"No se pudo publicar la migración; se revirtió: {exc}") from exc
    manifest["status"] = "active"
    manifest_path.write_text(json.dumps(manifest, indent=2))
    return snapshot


def restore(record: dict, snapshot: Path, work: Path) -> None:
    path = Path(record["path"])
    if record["before"] is None:
        path.unlink()
        return
    backup = snapshot / record["before"]
    staged = work / "restore"
    if staged.exists() or staged.is_symlink():
        staged.unlink()
    link = record.get("link")
    source = path.parent / link if link else None
    if source is not None and source.is_file() and source.read_bytes() == backup.read_bytes():
        staged.symlink_to(link)
    else:
        shutil.copyfile(backup, staged)
        staged.chmod(record["mode"])
    os.replace(staged, path)


def rollback(which: str, root: Path, binary: str, work: Path, dry_run: bool) -> None:
    if hyprland_version(binary) >= (0, 57):
        raise MigrationError("Hyprland 0.57+ retiró el soporte anunciado de .conf; no se activa el formato anterior.")
    candidates = sorted(state_root().glob("*/manifest.json"), reverse=True)
    if which != "latest":
        candidates = [p for p in candidates if p.parent.name == which]
    for candidate in candidates:
        manifest = json.loads(candidate.read_text())
        if manifest["config_dir"] != str(root) or manifest.get("status") != "active":
            continue
        records = [r for r in manifest["files"] if Path(r["path"]).name != "hyprland-migrate"]
        for record in records:
            path = Path(record["path"])
            if not path.is_file() or digest(path.read_bytes()) != record["after"]:
                raise MigrationError(f"{path.name} cambió después de migrar; se conserva. Reversión cancelada.")
        verify(binary, root / "hyprland.conf")
        if not dry_run:
            for record in reversed(records):
                restore(record, candidate.parent, work)
            manifest["status"] = "reverted"
            candidate.write_text(json.dumps(manifest, indent=2))
        print("Reversión verificada." if dry_run else "Migración revertida. El cambio de formato requiere iniciar sesión nuevamente.")
        return
    raise MigrationError("No hay una migración pendiente de revertir para esta configuración.")


def sync_generated(root: Path, binary: str, converter: str, work: Path) -> None:
    manifests = sorted(state_root().glob("*/manifest.json"), reverse=True)
    manifest_path = next((p for p in manifests if json.loads(p.read_text()).get("config_dir") == str(root)
                          and json.loads(p.read_text()).get("status") == "active"), None)
    if manifest_path is None:
        raise MigrationError("No hay manifiesto para actualizar módulos generados.")
    manifest = json.loads(manifest_path.read_text())
    modules = {Path(r["path"]): r for r in manifest["files"] if Path(r["path"]).name in {"monitors.lua", "vm-performance.lua"}}
    pending = {}
    for target, record in modules.items():
        if digest(target.read_bytes()) != record["after"]:
            raise MigrationError(f"{target.name} tiene cambios personales; no se reemplaza.")
        content = convert(converter, target.with_suffix(".conf").read_text())
        candidate = work / target.name
        candidate.write_text(content)
        if content.encode() != target.read_bytes():
            pending[target] = content.encode()
    if not pending:
        return
    main_text = (root / "hyprland.lua").read_text()
    for target in pending:
        main_text = main_text.replace(json.dumps(str(target)), json.dumps(str(work / target.name)))
    candidate = work / "verify-generated.lua"
    candidate.write_text(main_text)
    verify(binary, candidate)
    previous = {target: target.read_bytes() for target in pending}
    published = []
    try:
        for index, (target, data) in enumerate(pending.items()):
            staged = work / f"sync-{index}"
            staged.write_bytes(data)
            staged.chmod(0o600)
            os.replace(staged, target)
            published.append(target)
            modules[target]["after"] = digest(data)
        manifest_path.write_text(json.dumps(manifest, indent=2))
    except OSError:
        for target in reversed(published):
            staged = work / "sync-restore"
            staged.write_bytes(previous[target])
            staged.chmod(0o600)
            os.replace(staged, target)
        raise
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        result = run(["hyprctl", "reload"])
        if result.returncode or result.stdout.strip().lower() != "ok":
            raise MigrationError("Los módulos se actualizaron, pero la recarga de Hyprland no se confirmó.")


def set_border(value: str, binary: str = "Hyprland") -> None:
    parts = value.split()
    angle = 0
    if parts and re.fullmatch(r"\d+deg", parts[-1]):
        angle = int(parts.pop()[:-3])
    colors = []
    for part in parts:
        if re.fullmatch(r"0x[0-9a-fA-F]{8}", part):
            part = "rgba(" + part[4:] + part[2:4] + ")"
        if not re.fullmatch(r"(?:rgba\([0-9a-fA-F]{8}\)|rgb\([0-9a-fA-F]{6}\))", part):
            raise MigrationError("Color de borde no admitido.")
        colors.append(part)
    if not colors or not 0 <= angle <= 360:
        raise MigrationError("Gradiente de borde no válido.")
    expression = 'hl.config({general={col={active_border={colors={' + ','.join(json.dumps(c) for c in colors) + f'}},angle={angle}' + '}}}})'
    if hyprland_version(binary) < (0, 55):
        result = run(["hyprctl", "keyword", "general:col.active_border", value])
    else:
        result = run(["hyprctl", "eval", expression])
    if "only supported with the lua config manager" in result.stdout + result.stderr:
        result = run(["hyprctl", "keyword", "general:col.active_border", value])
    if result.returncode or result.stdout.strip().lower() != "ok":
        raise MigrationError("Hyprland no pudo aplicar el borde del tema.")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config-dir", type=Path, default=Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "hypr")
    parser.add_argument("--converter")
    parser.add_argument("--hyprland", default="Hyprland")
    parser.add_argument("--dry-run", action="store_true")
    actions = parser.add_mutually_exclusive_group()
    actions.add_argument("--rollback", nargs="?", const="latest")
    actions.add_argument("--sync-generated", action="store_true")
    actions.add_argument("--set-border")
    args = parser.parse_args()
    root = Path(os.path.abspath(args.config_dir))
    cache = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "tmp/work"
    cache.mkdir(parents=True, exist_ok=True)
    try:
        if args.set_border:
            set_border(args.set_border, args.hyprland)
            return 0
        if root.is_symlink():
            raise MigrationError("La carpeta Hyprland es un symlink. Crea primero una copia local para conservar el repositorio intacto.")
        with tempfile.TemporaryDirectory(prefix="hyprland-migrate-", dir=cache) as directory:
            work = Path(directory)
            if (root / "hyprland.lua").is_symlink() and not args.rollback and not args.sync_generated:
                print("Ya existe un enlace hyprland.lua; se conserva sin modificaciones.")
                return 0
            if (root / "hyprland.lua").exists() and not args.sync_generated and not args.rollback:
                print("Ya existe hyprland.lua; se conserva sin modificaciones.")
                return 0
            if not (root / "hyprland.conf").is_file():
                raise MigrationError("No existe una configuración Hyprland instalada para migrar.")
            with (root / "hyprland.conf").open("rb") as lock:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                if args.rollback:
                    rollback(args.rollback, root, args.hyprland, work, args.dry_run)
                    return 0
                if hyprland_version(args.hyprland) < (0, 55):
                    print("Hyprland anterior a 0.55: se conserva .conf.")
                    return 0
                converter = converter_path(args.converter, work, args.dry_run)
                if args.sync_generated:
                    if args.dry_run:
                        raise MigrationError("--sync-generated no admite --dry-run.")
                    sync_generated(root, args.hyprland, converter, work)
                    return 0
                changes, originals, candidate = staged_config(root, work, converter)
                verify(args.hyprland, candidate)
                helper = root / "scripts/auto_monitors.sh"
                if helper.is_file() and (any(p.name in {"monitors.lua", "vm-performance.lua"} for p in changes) or (root / "monitors.lua").is_file()):
                    text = helper.read_text()
                    if MARKER not in text:
                        if re.search(r"^\s*trap\b", text, re.MULTILINE):
                            raise MigrationError("auto_monitors.sh tiene un trap personalizado; requiere integración manual.")
                        installed = Path.home() / ".local/bin/hyprland-migrate"
                        command = f"{shlex.quote(str(installed))} --config-dir {shlex.quote(str(root))} --sync-generated"
                        hook = f"{MARKER}\ntrap {shlex.quote(command)} EXIT\n"
                        first, separator, rest = text.partition("\n")
                        if not first.startswith("#!"):
                            raise MigrationError("auto_monitors.sh no tiene un intérprete reconocido.")
                        rest = rest.replace("nwg-displays &", "nwg-displays")
                        changes[helper] = (first + separator + hook + rest).encode()
                        originals[helper] = helper.read_bytes()
                        hook_candidate = work / "auto_monitors.sh"
                        hook_candidate.write_bytes(changes[helper])
                        if run(["bash", "-n", str(hook_candidate)]).returncode:
                            raise MigrationError("El helper de monitores no pasó la validación de Bash.")
                installed = Path.home() / ".local/bin/hyprland-migrate"
                changes[installed] = Path(__file__).read_bytes()
                for prefix in (Path.home() / ".config/bin", Path.home() / ".local/bin"):
                    selector = prefix / "theme_selector"
                    if selector.is_file():
                        old = selector.read_text()
                        updated = re.sub(r'hyprctl keyword general:col\.active_border ("[^"\n]+")',
                                         lambda m: shlex.quote(str(installed)) + " --set-border " + m[1], old)
                        if updated != old:
                            changes[selector] = updated.encode()
                            originals[selector] = selector.read_bytes()
                    settings = prefix / "settings_menu"
                    if settings.is_file():
                        old = settings.read_text()
                        updated = old.replace('kitty -e nvim ~/.config/hypr/hyprland.conf &',
                                              f'kitty -e nvim {shlex.quote(str(root / "hyprland.lua"))} &')
                        if updated != old:
                            changes[settings] = updated.encode()
                            originals[settings] = settings.read_bytes()
                for index, (path, content) in enumerate(changes.items()):
                    if path.name in {"settings_menu", "theme_selector"}:
                        script_candidate = work / f"helper-{index}.sh"
                        script_candidate.write_bytes(content)
                        if run(["bash", "-n", str(script_candidate)]).returncode:
                            raise MigrationError(f"{path.name} no pasó la validación de Bash.")
                # El archivo principal se publica al final, después de sus dependencias.
                main_path = root / "hyprland.lua"
                main_bytes = changes.pop(main_path)
                changes[main_path] = main_bytes
                if args.dry_run:
                    print(f"Migración validada: {len(originals)} archivos conservados; ningún cambio aplicado.")
                    return 0
                snapshot = commit(changes, originals, work, root)
                print(f"Migración validada y publicada. Respaldo: {snapshot}")
                print("La sesión actual continúa en .conf; Lua se usará en el próximo inicio de sesión.")
                return 0
    except (MigrationError, OSError, UnicodeError, ValueError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
