#!/usr/bin/env python3
"""Configurador de perfiles y posiciones BLACK-ICE."""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import threading
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
import black_ice_theme as model
from black_ice_i18n import bind, translate
from black_ice_outputs import OutputChecks
from gi.repository import Gdk, GdkPixbuf, GLib, Gtk, Pango

CSS = b'''
window { background:#0c1420; color:#edf3fb; font-family:"Roboto"; font-size:14px; }
headerbar { background:#101d2c; border-bottom:1px solid #24384f; }
entry, spinbutton, combobox button, fontbutton button { background:#132235; color:#edf3fb; border:1px solid #39506a; min-height:30px; }
button:not(.titlebutton) { padding:7px 12px; background:#132235; color:#edf3fb; border:1px solid #39506a; }
button:not(.titlebutton):hover { background:#1d354f; }
button:not(.titlebutton):disabled { color:#b1c0d2; background:#101d2c; }
button.suggested-action { background:#94c5f2; color:#0c1420; }
stacksidebar, stacksidebar list { background:#101d2c; }
stacksidebar row:selected { background:#1d354f; color:#edf3fb; }
switch:checked { background:#94c5f2; }
checkbutton check:checked { background:#94c5f2; border-color:#94c5f2; color:#0c1420; }
label.heading { font-size:23px; font-weight:600; margin-bottom:6px; }
label.muted { color:#b1c0d2; }
label.error { color:#ff9ca5; }
*:focus { outline:2px solid #94c5f2; outline-offset:2px; }
'''


class Studio(Gtk.Window):
    def __init__(self) -> None:
        super().__init__(title="BLACK-ICE · Estudio de temas")
        self.set_wmclass("black-ice-theme-studio", "black-ice-theme-studio")
        screen = self.get_screen()
        monitor = screen.get_monitor_geometry(screen.get_primary_monitor())
        self.set_default_size(min(1060, monitor.width - 60), min(700, monitor.height - 120))
        self.set_size_request(690, 520)
        self.connect("destroy", Gtk.main_quit)
        self.connect("key-press-event", self.keypress)
        provider = Gtk.CssProvider()
        actual = model.current()
        active = model.defaults(actual if actual in model.themes() else model.themes()[0])
        css = CSS
        for original, key in [("#0c1420", "bg"), ("#edf3fb", "fg"), ("#94c5f2", "acc1"), ("#b1c0d2", "dim")]:
            css = css.replace(original.encode(), active["palette"][key].encode())
        provider.load_from_data(css)
        Gtk.StyleContext.add_provider_for_screen(screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
        self.loading = True
        self.busy = False
        self.profile = model.defaults(model.current() if model.current() in model.themes() else model.themes()[0])
        self.controls = {}
        self.module_controls = {}
        self.preview_image = None
        self.drag = None
        self.hit_regions = []
        self.undo_moves = []
        self.redo_moves = []
        try:
            self.display_specs = json.loads(subprocess.check_output(["hyprctl", "-j", "monitors"], text=True, timeout=3))
        except (OSError, ValueError, subprocess.SubprocessError):
            self.display_specs = []
        self.work = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "black-ice/theme-studio"
        self.work.mkdir(parents=True, exist_ok=True, mode=0o700)
        header = Gtk.HeaderBar(title="Estudio de temas", subtitle="BLACK-ICE · tu escritorio, tu composición")
        header.set_show_close_button(True)
        self.set_titlebar(header)
        save = Gtk.Button(label="Guardar perfil")
        save.connect("clicked", lambda *_: self.save_profile(False))
        header.pack_end(save)
        self.apply_button = Gtk.Button(label="Guardar y aplicar")
        self.apply_button.get_style_context().add_class("suggested-action")
        self.apply_button.connect("clicked", lambda *_: self.save_profile(True))
        header.pack_end(self.apply_button)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.add(outer)
        body = Gtk.Box(spacing=0)
        outer.pack_start(body, True, True, 0)
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(120)
        sidebar = Gtk.StackSidebar()
        sidebar.set_stack(self.stack)
        sidebar.set_size_request(154, -1)
        body.pack_start(sidebar, False, False, 0)
        body.pack_start(self.stack, True, True, 0)
        self.status = Gtk.Label(label="Los cambios se aplican solo al guardar y aplicar.", xalign=0)
        self.status.set_line_wrap(True)
        self.status.set_margin_start(20)
        self.status.set_margin_end(20)
        self.status.set_margin_top(10)
        self.status.set_margin_bottom(10)
        outer.pack_start(self.status, False, False, 0)
        self.build_profiles()
        self.build_editor()
        self.build_composition()
        self.build_typography()
        self.build_modules()
        self.build_desktop()
        self.build_login()
        self.load_controls()
        bind(self)
        self.show_all()
        self.stack.set_visible_child_name("visual")

    def page(self, key: str, title: str, detail: str) -> Gtk.Box:
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        for setter in (box.set_margin_start, box.set_margin_end, box.set_margin_top, box.set_margin_bottom):
            setter(24)
        heading = Gtk.Label(label=title, xalign=0)
        heading.get_style_context().add_class("heading")
        box.pack_start(heading, False, False, 0)
        self.note(box, detail)
        scroll.add(box)
        self.stack.add_titled(scroll, key, title)
        return box

    def note(self, page: Gtk.Box, text: str) -> None:
        label = Gtk.Label(label=text, xalign=0)
        label.set_line_wrap(True)
        label.set_max_width_chars(64)
        label.get_style_context().add_class("muted")
        page.pack_start(label, False, False, 0)

    def row(self, page: Gtk.Box, title: str, widget: Gtk.Widget) -> None:
        row = Gtk.Box(spacing=18)
        label = Gtk.Label(label=title, xalign=0)
        label.set_line_wrap(True)
        row.pack_start(label, True, True, 0)
        row.pack_end(widget, False, False, 0)
        page.pack_start(row, False, False, 0)

    def combo(self, page: Gtk.Box, key: str, title: str, options: dict) -> Gtk.ComboBoxText:
        widget = Gtk.ComboBoxText()
        for value, label in options.items():
            widget.append(value, label)
        widget.connect("changed", self.changed)
        self.controls[key] = widget
        self.row(page, title, widget)
        return widget

    def spin(self, page: Gtk.Box, key: str, title: str, low: float, high: float, step: float = 1) -> None:
        widget = Gtk.SpinButton.new_with_range(low, high, step)
        widget.set_digits(2 if step < 1 else 0)
        widget.connect("value-changed", self.changed)
        self.controls[key] = widget
        self.row(page, title, widget)

    def toggle(self, page: Gtk.Box, key: str, title: str) -> None:
        widget = Gtk.Switch()
        widget.connect("notify::active", self.changed)
        self.controls[key] = widget
        self.row(page, title, widget)

    def button(self, page: Gtk.Box, title: str, callback) -> Gtk.Button:
        widget = Gtk.Button(label=title)
        widget.connect("clicked", callback)
        page.pack_start(widget, False, False, 0)
        return widget

    def monitors(self) -> list[str]:
        try:
            result = subprocess.run(["hyprctl", "-j", "monitors"], capture_output=True, text=True, timeout=3, check=True)
            return [v["name"] for v in json.loads(result.stdout)]
        except (OSError, ValueError, KeyError, subprocess.SubprocessError):
            return []

    def build_profiles(self) -> None:
        page = self.page("profiles", "Perfiles", "Parte de un tema original, ajusta su composición y guarda tu versión. Los originales siguen disponibles.")
        self.controls["name"] = Gtk.Entry()
        self.controls["name"].connect("changed", self.changed)
        self.row(page, "Nombre de tu perfil", self.controls["name"])
        self.combo(page, "base", "Tema base", {name: name for name in model.themes() if not name.startswith("User-")})
        self.controls["base"].connect("changed", self.base_changed)
        self.saved = Gtk.ComboBoxText()
        self.refresh_saved()
        self.row(page, "Perfiles guardados", self.saved)
        self.button(page, "Eliminar perfil seleccionado", self.delete_profile)
        self.trash = Gtk.ComboBoxText()
        self.row(page, "Papelera de perfiles", self.trash)
        self.button(page, "Restaurar perfil de la papelera", self.restore_profile)
        self.refresh_trash()
        for items in [[("Cargar perfil", self.load_saved), ("Recuperar tema base", self.reset)],
                      [("Exportar JSON", lambda *_: self.transfer_profile(False)), ("Importar JSON", lambda *_: self.transfer_profile(True))]]:
            actions = Gtk.Box(spacing=12, homogeneous=True)
            for title, callback in items:
                self.button(actions, title, callback)
            page.pack_start(actions, False, False, 0)

    def build_editor(self) -> None:
        page = self.page("visual", "Posiciones", "Vista simple para ordenar módulos y mover Conky. Para elegir barras, colores, fuentes o estilos, usa las otras pestañas. Los cambios se guardan en tu perfil.")
        actions = Gtk.Box(spacing=10)
        self.button(actions, "Deshacer movimiento", lambda *_: self.undo_move(False))
        self.button(actions, "Rehacer movimiento", lambda *_: self.undo_move(True))
        zoom = Gtk.CheckButton(label="Ampliar al 100 %")
        zoom.connect("toggled", self.zoom_preview)
        actions.pack_end(zoom, False, False, 0)
        page.pack_start(actions, False, False, 0)
        self.preview = Gtk.DrawingArea()
        self.preview.set_size_request(-1, 370)
        self.preview.set_can_focus(True)
        self.preview.set_has_tooltip(True)
        self.preview.connect("query-tooltip", self.preview_tooltip)
        self.preview.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK | Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.KEY_PRESS_MASK)
        self.preview.connect("draw", self.draw_preview)
        self.preview.connect("button-press-event", self.drag_start)
        self.preview.connect("motion-notify-event", self.drag_motion)
        self.preview.connect("button-release-event", self.drag_end)
        self.preview.connect("key-press-event", self.drag_key)
        self.visual_scroll = Gtk.ScrolledWindow()
        self.visual_scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        self.visual_scroll.set_min_content_height(370)
        self.visual_scroll.add(self.preview)
        page.pack_start(self.visual_scroll, True, True, 0)
        self.note(page, "Arrastra entre zonas y barras. Escritorios al centro y bandeja a la derecha. Ocultar retira un módulo; Módulos permite recuperarlo. Esc cancela. Esta vista aproxima la distribución; etiquetas y cifras son ilustrativas.")

    def build_composition(self) -> None:
        page = self.page("bars", "Barras", "Elige la geometría y distribución. Los escritorios quedan centrados y la bandeja a la derecha; las pantallas estrechas agrupan controles.")
        self.combo(page, "layout", "Distribución", model.LAYOUTS)
        self.combo(page, "shape", "Terminaciones", model.SHAPES)
        self.combo(page, "lab_side", "Docker y máquinas virtuales", {"left": "A la izquierda", "right": "A la derecha"})
        self.combo(page, "workspace_style", "Símbolos de escritorios", {"base": "Del tema", "numbers": "Números", "dots": "Círculos", "diamonds": "Rombos", "code": "Código", "ankh": "Ankh", "shields": "Escudos", "japanese": "Kanji japoneses"})
        self.combo(page, "output", "Mostrar barras en", {"all": "Todas las pantallas", **{n: n for n in self.monitors()}})
        self.spin(page, "height", "Altura de barra · px", 28, 60)
        self.spin(page, "spacing", "Separación de módulos · px", 0, 12)
        self.spin(page, "opacity", "Opacidad del panel", .3, 1, .05)
        self.note(page, "La opacidad se aplica a las formas Angular, Recto, Redondeado y Relieve. Estilo original conserva la superficie del tema base.")

    def build_typography(self) -> None:
        page = self.page("type", "Fuentes y colores", "Inter, Roboto, Ubuntu Sans, Oxanium, Rajdhani, Barlow Condensed y Share Tech Mono. Los iconos conservan Nerd Font; la paleta se comparte con Kitty, bloqueo, launcher y notificaciones.")
        for key, title in [("font", "Fuente del escritorio"), ("data_font", "Fuente de IP y datos")]:
            widget = Gtk.FontButton()
            widget.set_use_font(True)
            widget.set_show_size(False)
            widget.connect("font-set", self.changed)
            self.controls[key] = widget
            self.row(page, title, widget)
        self.spin(page, "font_size", "Tamaño de Waybar · px", 10, 18)
        self.spin(page, "weight", "Peso tipográfico", 300, 800, 100)
        for key, title in [("bg", "Superficie"), ("fg", "Texto"), ("acc1", "Acento principal"), ("acc2", "Acento secundario"), ("dim", "Texto secundario")]:
            widget = Gtk.ColorButton()
            widget.connect("color-set", self.changed)
            self.controls["palette." + key] = widget
            self.row(page, title, widget)

    def build_modules(self) -> None:
        page = self.page("modules", "Módulos", "Configura qué aparece y dónde. VPN espera tun0. Docker y VM se ocultan sin docker o virsh y aparecen al instalarlos, en un máximo de 15 segundos.")
        for key, title in model.MODULES.items():
            options = {"default": "Del tema", "left": "Izquierda", "center": "Centro", "right": "Derecha", "hidden": "Oculto"}
            if key == "hyprland/workspaces":
                options = {k: v for k, v in options.items() if k in {"default", "center", "hidden"}}
            if key == "tray":
                options = {k: v for k, v in options.items() if k in {"default", "right", "hidden"}}
            widget = self.combo(page, "module." + key, title, options)
            self.module_controls[key] = widget
        installed = [label + (": instalado" if shutil.which(binary) else ": aparecerá al instalar") for label, binary in [("Docker", "docker"), ("VM / libvirt", "virsh")]]
        self.note(page, " · ".join(installed))

    def build_desktop(self) -> None:
        page = self.page("desktop", "Fondo y Conky", "El fondo y el monitor de escritorio forman parte del perfil. Ajusta tamaño, transparencia y posición sin tapar la imagen principal.")
        chooser = Gtk.FileChooserButton(title="Selecciona el fondo", action=Gtk.FileChooserAction.OPEN)
        file_filter = Gtk.FileFilter()
        file_filter.set_name("Imágenes")
        for mime in ("image/png", "image/jpeg", "image/webp", "image/avif"):
            file_filter.add_mime_type(mime)
        chooser.add_filter(file_filter)
        chooser.connect("file-set", self.changed)
        self.controls["wallpaper"] = chooser
        self.row(page, "Wallpaper y bloqueo", chooser)
        self.combo(page, "wallpaper_mode", "Fondos en varias pantallas", {"auto": "Packs automáticos del tema", "mirror": "Mismo fondo en cada pantalla", "panorama": "Panorama por fila de pantallas", "scene": "Escena única para todas las pantallas"})
        self.toggle(page, "conky.enabled", "Mostrar Conky")
        self.combo(page, "conky.variant", "Estilo de Conky", {n: n.capitalize() for n in ("obsidian", "fsociety", "fracture", "signal", "orbit", "ribbon", "terminal", "pulse", "atlas", "horizon", "observatory", "polar", "chronos", "nexus", "gotham", "prism", "circuit", "scope", "stack", "focus")})
        self.combo(page, "conky.color", "Combinación de color", {"theme": "Del tema", "swap": "Acentos invertidos", "ice": "Hielo", "acid": "Ácido", "ember": "Ámbar", "orchid": "Orquídea", "mono": "Monocromo"})
        self.combo(page, "conky.position", "Posición", {v + "_" + h: vl + " · " + hl for v, vl in [("top", "Arriba"), ("middle", "Centro"), ("bottom", "Abajo")] for h, hl in [("left", "Izquierda"), ("middle", "Centro"), ("right", "Derecha")]})
        self.combo(page, "conky.output", "Pantallas de Conky", {"auto": "Una automática", "all": "Todas las conectadas", "selected": "Elegir varias", **{n: n for n in self.monitors()}})
        outputs = OutputChecks(self.monitors(), self.profile["conky"].get("outputs", []), self.changed)
        self.controls["conky.outputs"] = outputs
        self.row(page, "Pantallas elegidas", outputs)
        self.controls["conky.output"].connect("changed", lambda widget: outputs.set_sensitive(widget.get_active_id() == "selected"))
        self.spin(page, "conky.opacity", "Opacidad de Conky", .55, .95, .05)
        self.spin(page, "conky.zoom", "Escala de Conky", .65, 1.35, .05)
        self.spin(page, "conky.offset_x", "Desplazamiento horizontal · px", -4000, 4000, 5)
        self.spin(page, "conky.offset_y", "Desplazamiento vertical · px", -4000, 4000, 5)
        self.button(page, "Abrir galería de los 20 estilos de Conky", lambda *_: subprocess.Popen([str(Path.home() / ".local/bin/conky_visual")]))

    def build_login(self) -> None:
        page = self.page("login", "Inicio de sesión", "Elige un tema de SDDM y revisa la vista previa. Aplicarlo cambia el próximo acceso y conserva la selección anterior para restaurarla.")
        self.combo(page, "sddm.theme", "Tema de SDDM", {n: n for n in model.sddm_themes()})
        self.toggle(page, "sddm.follow", "Usar fondo, colores y fuente del perfil")
        self.note(page, "BLACK-ICE Obsidiana admite estos ajustes. Otros temas pueden usar sus propios controles visuales. El bloqueo Hyprlock sigue el fondo y los colores al aplicar el perfil.")
        self.button(page, "Vista previa de SDDM", lambda *_: self.preview_sddm())
        self.button(page, "Aplicar SDDM para el próximo acceso", lambda *_: self.apply_sddm())
        self.button(page, "Restaurar selección anterior de SDDM", lambda *_: self.run_job(model.restore_sddm, "Selección anterior de SDDM restaurada."))

    def refresh_saved(self) -> None:
        self.saved.remove_all()
        for name in model.themes():
            value = model.read_json(model.ROOT / name / "profile.json")
            if value:
                self.saved.append(name, value.get("name", name))
        self.saved.set_active(0)

    def load_controls(self) -> None:
        self.loading = True
        for key, widget in self.controls.items():
            if key.startswith("module."):
                value = self.profile["modules"].get(key[7:], "default")
            elif "." in key:
                section, field = key.split(".", 1)
                value = self.profile[section].get(field, [] if field == "outputs" else None)
            else:
                value = self.profile.get(key, "base" if key == "workspace_style" else "auto")
            if isinstance(widget, OutputChecks):
                widget.set_selection(value)
                widget.set_sensitive(self.profile["conky"]["output"] == "selected")
            elif isinstance(widget, Gtk.ComboBoxText):
                if value and not widget.set_active_id(str(value)):
                    widget.append(str(value), str(value))
                    widget.set_active_id(str(value))
            elif isinstance(widget, Gtk.SpinButton):
                widget.set_value(value)
            elif isinstance(widget, Gtk.Switch):
                widget.set_active(value)
            elif isinstance(widget, Gtk.FontButton):
                widget.set_font_name(value + " 12")
            elif isinstance(widget, Gtk.ColorButton):
                rgba = Gdk.RGBA()
                rgba.parse(value)
                widget.set_rgba(rgba)
            elif isinstance(widget, Gtk.FileChooserButton):
                widget.unselect_all()
                if value:
                    widget.set_filename(value)
            elif isinstance(widget, Gtk.Entry):
                widget.set_text(value)
        self.loading = False
        self.update_image()
        self.preview.queue_draw()

    def collect(self) -> dict:
        value = json.loads(json.dumps(self.profile))
        for key, widget in self.controls.items():
            if isinstance(widget, Gtk.ComboBoxText):
                selected = widget.get_active_id()
            elif isinstance(widget, Gtk.SpinButton):
                selected = widget.get_value()
            elif isinstance(widget, Gtk.Switch):
                selected = widget.get_active()
            elif isinstance(widget, Gtk.FontButton):
                selected = Pango.FontDescription.from_string(widget.get_font_name()).get_family()
            elif isinstance(widget, Gtk.ColorButton):
                rgba = widget.get_rgba()
                selected = "#" + "".join(f"{round(channel * 255):02x}" for channel in (rgba.red, rgba.green, rgba.blue))
            elif isinstance(widget, Gtk.FileChooserButton):
                selected = widget.get_filename() or ""
            else:
                selected = widget.get_text()
            if key.startswith("module."):
                value["modules"][key[7:]] = selected
            elif "." in key:
                section, field = key.split(".", 1)
                value[section][field] = selected
            else:
                value[key] = selected
        return value

    def changed(self, *_args) -> None:
        if self.loading:
            return
        self.profile = self.collect()
        self.update_image()
        self.preview.queue_draw()
        self.status.set_text("Cambios sin guardar · revisa la composición y guarda tu perfil.")

    def base_changed(self, widget: Gtk.ComboBoxText) -> None:
        if not self.loading and widget.get_active_id():
            name = self.profile["name"]
            self.profile = model.defaults(widget.get_active_id())
            self.profile["name"] = name
            self.load_controls()

    def update_image(self) -> None:
        wall = self.profile.get("wallpaper", "")
        if wall == getattr(self, "image_path", None):
            return
        self.image_path = wall
        try:
            self.preview_image = GdkPixbuf.Pixbuf.new_from_file_at_scale(wall, 1000, 600, True) if wall else None
        except GLib.Error:
            self.preview_image = None

    def preview_monitor(self) -> dict:
        preferred = self.profile["conky"].get("output", "auto")
        if preferred == "auto":
            preferred = self.profile.get("output", "all")
        screen = next((m for m in self.display_specs if m["name"] == preferred), None)
        screen = screen or next((m for m in self.display_specs if m["name"].startswith("eDP")), None)
        screen = screen or (self.display_specs[0] if self.display_specs else {"name":"Vista previa", "width":1366, "height":768})
        width, height = screen["width"], screen["height"]
        if screen.get("transform", 0) % 2:
            width, height = height, width
        scale = max(.1, screen.get("scale", 1))
        return {"name":screen["name"], "width":round(width / scale), "height":round(height / scale), "scale":1}

    def zoom_preview(self, widget):
        monitor = self.preview_monitor()
        self.preview.set_size_request(monitor["width"]+12 if widget.get_active() else -1,
                                      monitor["height"]+42 if widget.get_active() else 370)

    def preview_tooltip(self, _widget, x, y, _keyboard, tooltip):
        region = self.region_at(x,y)
        if region and region["kind"] in {"module", "conky"}:
            tooltip.set_text(model.MODULES.get(region["key"], "Conky") + " · arrastra para mover")
            return True
        return False

    def draw_preview(self, widget: Gtk.DrawingArea, ctx) -> bool:
        p, screen = self.profile, self.preview_monitor()
        width, height = widget.get_allocated_width(), widget.get_allocated_height()
        scale = min((width-12) / screen["width"], (height-42) / screen["height"])
        ox, oy = (width-screen["width"]*scale)/2, 4
        self.canvas_transform = (ox, oy, scale, screen)
        self.hit_regions = []
        ctx.set_source_rgb(.025, .035, .05)
        ctx.paint()
        ctx.save()
        ctx.rectangle(ox, oy, screen["width"]*scale, screen["height"]*scale)
        ctx.clip()
        ctx.translate(ox, oy)
        if self.preview_image:
            image = self.preview_image
            factor = max(screen["width"]*scale/image.get_width(), screen["height"]*scale/image.get_height())
            ctx.save()
            ctx.translate((screen["width"]*scale-image.get_width()*factor)/2, (screen["height"]*scale-image.get_height()*factor)/2)
            ctx.scale(factor, factor)
            Gdk.cairo_set_source_pixbuf(ctx, image, 0, 0)
            ctx.paint()
            ctx.restore()
        def color(key, opacity=1):
            rgb = p["palette"][key]
            ctx.set_source_rgba(*[int(rgb[i:i+2],16)/255 for i in (1,3,5)], opacity)
        def panel(x, y, w, h, opacity):
            color("bg", opacity)
            if p["shape"] == "angular":
                cut = min(13*scale, h/3)
                ctx.move_to(x+cut,y)
                for point in [(x+w,y),(x+w,y+h-cut),(x+w-cut,y+h),(x,y+h),(x,y+cut)]:
                    ctx.line_to(*point)
                ctx.close_path()
            else:
                ctx.rectangle(x,y,w,h)
            ctx.fill_preserve()
            color("acc1", .8)
            ctx.set_line_width(.8)
            ctx.stroke()
        def hit(kind, key, x, y, w, h, **data):
            self.hit_regions.append({"kind":kind,"key":key,"x":ox+x,"y":oy+y,"w":w,"h":h,**data})
        if p["conky"]["enabled"]:
            rect = model.conky_rectangle(p, screen)
            x,y,w,h = [rect[k]*scale for k in ("x","y","width","height")]
            panel(x,y,w,h,p["conky"]["opacity"])
            hit("conky","conky",x,y,w,h)
            ctx.select_font_face(p["data_font"])
            ctx.set_font_size(max(7,14*scale))
            for index, text in enumerate(["CPU 43°", "RAM 6 GiB", "SSD 40°", translate("RED") + " 0 KiB/s"]):
                color("fg" if index % 2 else "acc1")
                horizontal = w > h*2
                ctx.move_to(x+8+(index*w/4 if horizontal else 0), y+(h/2+3 if horizontal else (index+1)*h/5))
                ctx.show_text(translate(text))
        labels = {"custom/launcher":"Apps", "hyprland/workspaces":"○  ●  ○", "custom/local_ip":"IP", "custom/public_ip":"WAN", "custom/vpn":"VPN", "custom/privacy":"Tor", "custom/settarget":"Target", "custom/docker":"Dkr", "custom/kvm":"VM", "custom/updates":"Upd", "custom/player":"♫", "custom/weather":"°C", "network":"Red", "bluetooth":"BT", "pulseaudio":"Vol", "battery":"Bat", "clock":"Hora", "custom/control":"Cfg", "custom/power":"Off", "tray":"Tray"}
        for bar in model.bars(p):
            bh = p["height"]*scale
            y = 0 if bar["position"] == "top" else (screen["height"]-p["height"])*scale
            def flatten(names, bar=bar):
                result = []
                for name in names:
                    result.extend(flatten(bar.get(name,{}).get("modules",[])) if name.startswith("group/") else [name])
                return result
            for zone, start, fraction in [("left",.003,.36),("center",.37,.26),("right",.64,.357)]:
                x, w = screen["width"]*scale*start, screen["width"]*scale*fraction
                modules = flatten(bar["modules-"+zone])
                if self.drag:
                    color("acc1", .12)
                    ctx.rectangle(x,y,w,bh)
                    ctx.fill()
                if not modules:
                    continue
                panel(x,y,w,bh,p["opacity"])
                ctx.select_font_face(p["font"])
                ctx.set_font_size(max(7,p["font_size"]*scale))
                display_labels = {key: translate(labels.get(key, model.MODULES.get(key, key))) for key in modules}
                sizes = []
                for key in modules:
                    ctx.select_font_face("JetBrainsMono Nerd Font" if key in {"hyprland/workspaces", "custom/player"} else p["font"])
                    sizes.append(ctx.text_extents(display_labels[key])[4] + 10)
                fit = min(1,(w-8)/sum(sizes))
                cursor = x+4+(max(0,w-8-sum(sizes)*fit)/2 if zone == "center" else 0)
                for key, size in zip(modules,sizes):
                    chip = size*fit
                    color("acc1", .18)
                    ctx.rectangle(cursor+1,y+2,max(1,chip-2),max(1,bh-4))
                    ctx.fill()
                    color("fg")
                    ctx.save()
                    ctx.translate(cursor+3,y+bh*.69)
                    ctx.scale(fit,1)
                    ctx.select_font_face("JetBrainsMono Nerd Font" if key in {"hyprland/workspaces", "custom/player"} else p["font"])
                    ctx.show_text(display_labels[key])
                    ctx.restore()
                    hit("module",key,cursor,y,chip,bh,zone=zone,bar=bar["position"])
                    cursor += chip
        ctx.restore()
        ctx.set_source_rgb(.12,.17,.22)
        ctx.rectangle(width-104,height-29,98,24)
        ctx.fill()
        ctx.set_source_rgb(.9,.94,.98)
        ctx.select_font_face(p["font"])
        ctx.set_font_size(11)
        ctx.move_to(width-88,height-13)
        ctx.show_text(translate("Ocultar"))
        self.hit_regions.append({"kind":"hide","key":"hide","x":width-104,"y":height-29,"w":98,"h":24})
        ctx.move_to(8,height-13)
        ctx.show_text(f'{screen["name"]} · {screen["width"]}×{screen["height"]}')
        if self.drag and self.drag["kind"] == "module":
            ctx.set_source_rgba(.03,.05,.08,.95)
            ctx.rectangle(self.drag["pointer_x"],self.drag["pointer_y"]-22,110,22)
            ctx.fill()
            ctx.set_source_rgb(.94,.96,1)
            ctx.move_to(self.drag["pointer_x"]+5,self.drag["pointer_y"]-7)
            ctx.show_text(translate(model.MODULES[self.drag["key"]]))
        return False

    def region_at(self, x, y):
        return next((r for r in reversed(self.hit_regions) if r["x"] <= x <= r["x"]+r["w"] and r["y"] <= y <= r["y"]+r["h"]), None)

    def drag_start(self, widget, event):
        if event.button != 1 or self.busy:
            return False
        region = self.region_at(event.x,event.y)
        if not region or region["kind"] == "hide":
            return False
        widget.grab_focus()
        self.drag = {**region,"before":json.loads(json.dumps(self.profile)),"grab_x":event.x-region["x"],"grab_y":event.y-region["y"],"pointer_x":event.x,"pointer_y":event.y}
        self.preview.queue_draw()
        return True

    def drag_motion(self, _widget, event):
        if not self.drag:
            return False
        self.drag.update(pointer_x=event.x,pointer_y=event.y)
        if self.drag["kind"] == "conky":
            ox,oy,scale,screen = self.canvas_transform
            model.move_conky(self.profile,screen,(event.x-self.drag["grab_x"]-ox)/scale,(event.y-self.drag["grab_y"]-oy)/scale)
        self.preview.queue_draw()
        return True

    def drag_end(self, _widget, event):
        if not self.drag or event.button != 1:
            return False
        drag = self.drag
        if drag["kind"] == "module":
            ox,oy,scale,screen = self.canvas_transform
            x,y = (event.x-ox)/scale,(event.y-oy)/scale
            target = self.region_at(event.x,event.y)
            hide = target and target["kind"] == "hide"
            position = "top" if y < screen["height"]/2 else "bottom"
            valid = any(b["position"] == position for b in model.bars(self.profile)) and (y <= self.profile["height"]*1.8 or y >= screen["height"]-self.profile["height"]*1.8)
            if hide or valid and 0 <= x <= screen["width"]:
                zone = "hidden" if hide else "left" if x < screen["width"]*.37 else "right" if x >= screen["width"]*.64 else "center"
                before = target["key"] if target and target["kind"] == "module" and target["key"] != drag["key"] else None
                model.move_module(self.profile,drag["key"],zone,position,before)
        if self.profile != drag["before"]:
            self.undo_moves.append(drag["before"])
            self.undo_moves = self.undo_moves[-30:]
            self.redo_moves.clear()
        self.drag = None
        self.load_controls()
        self.status.set_text("Composición modificada · guarda tu perfil para conservarla.")
        return True

    def drag_key(self, _widget, event):
        if event.keyval == Gdk.KEY_Escape and self.drag:
            self.profile = self.drag["before"]
            self.drag = None
            self.load_controls()
            return True
        return False

    def undo_move(self, redo):
        source, target = (self.redo_moves,self.undo_moves) if redo else (self.undo_moves,self.redo_moves)
        if source:
            target.append(json.loads(json.dumps(self.profile)))
            self.profile = source.pop()
            self.load_controls()
            self.status.set_text("Movimiento recuperado · cambios sin guardar.")

    def load_saved(self, *_args) -> None:
        name = self.saved.get_active_id()
        if name:
            try:
                self.profile = model.defaults(name)
                self.load_controls()
                self.status.set_text("Perfil cargado. Guardar y aplicar activa esta configuración.")
            except (OSError, ValueError) as error:
                self.status.set_text(str(error))

    def refresh_trash(self) -> None:
        self.trash.remove_all()
        data = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share"))
        for path in sorted((data / "black-ice/deleted-themes").glob("*/User-*")):
            value = model.read_json(path / "profile.json")
            if value and not path.is_symlink():
                self.trash.append(str(path), value.get("name", path.name))
        self.trash.set_active(0)

    def delete_profile(self, *_args) -> None:
        name = self.saved.get_active_id()
        if not name or self.busy:
            return
        try:
            model.trash_theme(name)
            self.refresh_saved()
            self.refresh_trash()
            self.status.set_text("Perfil enviado a la papelera. Puedes restaurarlo aquí; su wallpaper se conserva.")
        except (OSError, ValueError) as error:
            self.status.set_text(str(error))

    def restore_profile(self, *_args) -> None:
        path = self.trash.get_active_id()
        if not path or self.busy:
            return
        try:
            name = model.restore_theme(Path(path))
            self.refresh_saved()
            self.saved.set_active_id(name)
            self.refresh_trash()
            self.status.set_text("Perfil restaurado. Cárgalo para revisarlo o aplicarlo.")
        except (OSError, ValueError) as error:
            self.status.set_text(str(error))

    def reset(self, *_args) -> None:
        self.profile = model.defaults(self.profile["base"])
        self.load_controls()
        self.status.set_text("Ajustes del tema base recuperados; el escritorio actual conserva su configuración.")

    def transfer_profile(self, importing: bool) -> None:
        dialog = Gtk.FileChooserDialog(title="Importar perfil" if importing else "Exportar perfil", transient_for=self,
                                       action=Gtk.FileChooserAction.OPEN if importing else Gtk.FileChooserAction.SAVE)
        dialog.add_buttons("Cancelar", Gtk.ResponseType.CANCEL, "Importar" if importing else "Exportar", Gtk.ResponseType.OK)
        if not importing:
            dialog.set_current_name("black-ice-theme.json")
            dialog.set_do_overwrite_confirmation(True)
        selected = dialog.run()
        filename = dialog.get_filename()
        dialog.destroy()
        if selected != Gtk.ResponseType.OK or not filename:
            return
        try:
            if importing:
                path = Path(filename)
                if path.stat().st_size > 65536:
                    raise ValueError("El perfil JSON supera 64 KiB")
                self.profile = model.validate(json.loads(path.read_text()))
                self.load_controls()
                self.status.set_text("Perfil importado. Revisa las pantallas y el fondo antes de aplicarlo.")
            else:
                value = model.validate(self.collect())
                model.atomic(Path(filename), json.dumps(value, ensure_ascii=False, indent=2) + "\n")
                self.status.set_text("Perfil exportado. El JSON referencia el fondo; lleva también la imagen al otro equipo.")
        except (OSError, ValueError) as error:
            self.status.set_text(str(error))

    def run_job(self, operation, message: str) -> None:
        if self.busy:
            return
        self.busy = True
        self.apply_button.set_sensitive(False)
        self.status.set_text("Aplicando…")
        def finish(error: str = "") -> bool:
            self.busy = False
            self.apply_button.set_sensitive(True)
            self.status.set_text(error or message)
            self.refresh_saved()
            return False
        def worker() -> None:
            try:
                operation()
                GLib.idle_add(finish)
            except (OSError, ValueError, GLib.Error, subprocess.SubprocessError) as error:
                detail = error.stderr.strip() if isinstance(error, subprocess.CalledProcessError) and error.stderr else str(error)
                GLib.idle_add(finish, "No se aplicó: " + detail[:300])
        threading.Thread(target=worker, daemon=True).start()

    def save_profile(self, activate: bool) -> None:
        try:
            profile = model.validate(self.collect())
        except ValueError as error:
            self.status.set_text(str(error))
            return
        def operation() -> None:
            name = model.save(profile)
            if activate:
                model.apply(name)
        self.run_job(operation, "Perfil guardado y aplicado." if activate else "Perfil guardado. Está disponible en la galería de temas.")

    def preview_sddm(self) -> None:
        try:
            destination = model.sddm_preview(self.collect(), self.work / "sddm-preview")
            executable = shutil.which("sddm-greeter-qt6") or shutil.which("sddm-greeter")
            if not executable:
                raise ValueError("Instala sddm para abrir la vista previa")
            subprocess.Popen([executable, "--test-mode", "--theme", str(destination)],
                             env={**os.environ, "QT_STYLE_OVERRIDE": "Fusion", "QT_QUICK_CONTROLS_STYLE": "Fusion"})
            self.status.set_text("Vista previa de SDDM abierta. Cierra la ventana para volver al editor.")
        except (OSError, ValueError, GLib.Error) as error:
            self.status.set_text(str(error))

    def apply_sddm(self) -> None:
        try:
            profile = model.validate(self.collect())
        except ValueError as error:
            self.status.set_text(str(error))
            return
        def operation() -> None:
            destination = model.sddm_preview(profile, self.work / "sddm-apply")
            model.install_sddm(destination)
        self.run_job(operation, "SDDM preparado para el próximo acceso. La sesión actual sigue activa.")

    def keypress(self, _window, event) -> bool:
        if event.state & Gdk.ModifierType.CONTROL_MASK and event.keyval == Gdk.KEY_s:
            self.save_profile(False)
            return True
        return False


def main() -> None:
    if not model.themes():
        raise SystemExit("Instala primero el catálogo de temas BLACK-ICE")
    Studio()
    Gtk.main()


if __name__ == "__main__":
    main()
