#!/usr/bin/env python3
"""Distribuye fondos estáticos según la geometría real de las pantallas."""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import logging
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

import black_ice_theme as themes
from black_ice_lock import update as update_lock

CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "black-ice/wallpapers"
STATE = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "black-ice/wallpapers.json"
LOG = logging.getLogger("black-ice-wallpaper")


def monitors() -> list[dict]:
    result = subprocess.run(["hyprctl", "-j", "monitors"], capture_output=True, text=True, check=True, timeout=4)
    value = json.loads(result.stdout)
    return [m for m in value if m.get("dpmsStatus", True) and m.get("width", 0) > 0 and m.get("height", 0) > 0]


def geometry(monitor: dict) -> dict:
    width, height = monitor["width"], monitor["height"]
    if monitor.get("transform", 0) in {1, 3, 5, 7}:
        width, height = height, width
    scale = max(.1, float(monitor.get("scale", 1)))
    return {"name": monitor["name"], "x": monitor.get("x", 0), "y": monitor.get("y", 0),
            "width": width / scale, "height": height / scale, "pixels": [width, height]}


def groups(outputs: list[dict]) -> list[list[dict]]:
    rows = []
    for output in sorted(outputs, key=lambda m: (m["y"], m["x"])):
        row = next((r for r in rows if abs(r[0]["y"] - output["y"]) <= min(r[0]["height"], output["height"]) * .2
                    and .75 <= r[0]["height"] / output["height"] <= 1.33), None)
        if row is None:
            rows.append([output])
        else:
            row.append(output)
    return rows


def plan(outputs: list[dict], path: Path, panorama: Path | None = None, mode: str = "auto", anchor: str = "center") -> list[dict]:
    outputs = [geometry(m) for m in outputs]
    rows = [outputs] if mode == "scene" and len(outputs) > 1 else groups(outputs) if mode != "mirror" and len(outputs) > 1 else [[m] for m in outputs]
    result = []
    for row in rows:
        left, top = min(m["x"] for m in row), min(m["y"] for m in row)
        width = max(m["x"] + m["width"] for m in row) - left
        height = max(m["y"] + m["height"] for m in row) - top
        source = panorama if mode != "scene" and len(row) > 1 and panorama and panorama.is_file() else path
        for monitor in row:
            result.append({"output": monitor["name"], "source": str(source), "pixels": monitor["pixels"],
                           "viewport": [monitor["x"] - left, monitor["y"] - top, monitor["width"], monitor["height"]],
                           "canvas": [width, height], "panoramic": len(row) > 1,
                           "anchor": anchor if len(row) > 1 else "center"})
    return result


def render(item: dict, destination: Path) -> None:
    import gi
    gi.require_version("GdkPixbuf", "2.0")
    from gi.repository import GdkPixbuf
    image = GdkPixbuf.Pixbuf.new_from_file(item["source"])
    canvas_w, canvas_h = item["canvas"]
    scale = max(canvas_w / image.get_width(), canvas_h / image.get_height())
    x, y, width, height = item["viewport"]
    source_x = (x + (image.get_width() * scale - canvas_w) / 2) / scale
    source_y = (y + (0 if item.get("anchor") == "top" else (image.get_height() * scale - canvas_h) / 2)) / scale
    source_w, source_h = width / scale, height / scale
    sx, sy = max(0, round(source_x)), max(0, round(source_y))
    sw = max(1, min(round(source_w), image.get_width() - sx))
    sh = max(1, min(round(source_h), image.get_height() - sy))
    crop = image.new_subpixbuf(sx, sy, sw, sh)
    output = crop if [sw, sh] == item["pixels"] else crop.scale_simple(*item["pixels"], GdkPixbuf.InterpType.BILINEAR)
    with tempfile.NamedTemporaryFile(dir=destination.parent, prefix=".render-", delete=False) as handle:
        temporary = Path(handle.name)
    try:
        output.savev(str(temporary), "png", ["compression"], ["6"])
        temporary.chmod(0o600)
        temporary.replace(destination)
    finally:
        temporary.unlink(missing_ok=True)


def apply(path: Path, desktop: bool = True) -> dict:
    path = path.expanduser().resolve()
    if not path.is_file() or path.suffix.lower() not in {".png", ".jpg", ".jpeg", ".webp", ".avif"}:
        raise ValueError("El fondo no existe o no es una imagen admitida")
    if any(c in str(path) for c in ("\x00", "\n", "\r")):
        raise ValueError("Ruta del fondo inválida")
    name = themes.current()
    metadata = themes.read_json(themes.ROOT / name / "theme.json")
    profile = themes.read_json(themes.ROOT / name / "profile.json")
    mode = profile.get("wallpaper_mode", metadata.get("wallpaper_mode", "auto"))
    if mode not in {"auto", "mirror", "panorama", "scene"}:
        mode = "auto"
    declared = metadata.get("panorama", "")
    panorama = themes.picture_dir() / "wallpapers" / declared if declared and Path(declared).name == declared else None
    # Un fondo escogido manualmente sustituye también el panorama del tema.
    expected = metadata.get("wallpaper_path") or str(themes.picture_dir() / "wallpapers" / metadata.get("wallpaper", ""))
    if str(path) != str(Path(expected).expanduser().resolve()):
        panorama = path if mode == "panorama" else None
        if mode == "scene" and profile.get("wallpaper_mode") != "scene":
            mode = "auto"
    outputs = monitors()
    if not outputs:
        return {"theme": name, "outputs": [], "mode": mode}
    anchor = metadata.get("panorama_anchor", "center") if panorama and path != panorama else "center"
    items = plan(outputs, path, panorama, "mirror" if mode == "auto" and not panorama else mode, anchor)
    identity = [{**item, "mtime": Path(item["source"]).stat().st_mtime_ns} for item in items]
    digest = hashlib.sha256(json.dumps(identity, sort_keys=True).encode()).hexdigest()[:20]
    folder = CACHE / digest
    folder.mkdir(parents=True, exist_ok=True, mode=0o700)
    for index, item in enumerate(items):
        destination = folder / f"output-{index}.png"
        if not destination.is_file():
            render(item, destination)
        if desktop:
            subprocess.run(["awww", "img", str(destination), "--outputs", item["output"], "--resize", "no",
                            "--transition-type", "none"], capture_output=True, text=True, check=True, timeout=12)
        item["rendered"] = str(destination)
    cached = sorted((p for p in CACHE.iterdir() if p.is_dir() and not p.is_symlink()
                     and len(p.name) == 20 and all(c in "0123456789abcdef" for c in p.name)),
                    key=lambda p: p.stat().st_mtime, reverse=True)
    for stale in cached[12:]:
        if stale != folder:
            shutil.rmtree(stale)
    state = {"theme": name, "wallpaper": str(path), "mode": mode, "outputs": items}
    themes.atomic(STATE, json.dumps(state, ensure_ascii=False, indent=2) + "\n")
    update_lock(themes.CONFIG / "hypr/hyprlock.conf", state, path, themes.atomic)
    return state


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("apply", "prepare", "refresh", "status"))
    parser.add_argument("path", nargs="?")
    args = parser.parse_args()
    if args.action == "status":
        print(json.dumps(themes.read_json(STATE), ensure_ascii=False))
        return 0
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", Path.home() / ".cache"))
    lock = (runtime / "black-ice-wallpaper.lock").open("w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if args.action == "refresh":
            path = Path((Path.home() / ".cache/current_wallpaper").read_text().strip())
        elif args.path:
            path = Path(args.path)
        else:
            parser.error("Falta indicar el fondo")
        apply(path, desktop=args.action != "prepare")
    except BlockingIOError:
        return 0
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        LOG.error("No se pudo distribuir el fondo: %s", error)
        return 1
    finally:
        lock.close()
    return 0


if __name__ == "__main__":
    sys.exit(main())
