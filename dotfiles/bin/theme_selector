#!/usr/bin/env bash
set -euo pipefail

controller="$HOME/.local/bin/black-ice-appearance"
if [[ ! -x "$controller" ]]; then
    notify-send 'BLACK-ICE' 'Falta el controlador de apariencia. Ejecuta el instalador visual.'
    exit 1
fi
theme=${1:-}
if [[ -z $theme ]]; then
    theme=$("$controller" themes | python -c 'import json,sys; print("\n".join(json.load(sys.stdin)))' |
        wofi --dmenu --prompt 'Tema del escritorio' --insensitive) || exit 0
fi
[[ -n $theme ]] || exit 0
if "$controller" apply "$theme"; then
    notify-send 'BLACK-ICE' "Tema activo: $theme"
else
    notify-send 'BLACK-ICE' 'No se pudo aplicar el tema.' --urgency=critical
    exit 1
fi
