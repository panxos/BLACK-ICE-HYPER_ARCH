#!/usr/bin/env python3
"""Selecciona el idioma de los controles del escritorio."""
import argparse
import json

from black_ice_i18n import language, set_language, translate


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("status", "set", "text"))
    parser.add_argument("value", nargs="?")
    args = parser.parse_args()
    if args.action == "set":
        if args.value not in {"es", "en"}:
            parser.error("Use es or en")
        set_language(args.value)
    elif args.action == "text":
        print(translate(args.value or ""))
        return 0
    print(json.dumps({"language": language()}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
