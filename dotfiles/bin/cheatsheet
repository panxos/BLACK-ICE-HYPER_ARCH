#!/usr/bin/env python3
"""Atajos activos de BLACK-ICE, con búsqueda y disponibilidad de programas."""
from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
from pathlib import Path

from black_ice_shortcuts import inventory
from black_ice_workspaces import IPC


def palette() -> dict:
    home = Path.home()
    base = Path(os.environ.get("XDG_CONFIG_HOME", home / ".config"))
    colors = {"bg": "#0c1118", "fg": "#e6edf3", "acc1": "#27c6ed", "dim": "#a4b5c2"}
    try:
        appearance = json.loads((home / ".local/state/black-ice/appearance.json").read_text())
        colors.update({k: v for k, v in appearance.get("palette", {}).items() if k in colors and re.fullmatch(r"#[0-9A-Fa-f]{6}", str(v))})
        name = appearance.get("theme", "Anubis-Sethek")
        metadata = json.loads((base / "waybar/themes" / name / "theme.json").read_text())
        font = metadata.get("font", "Roboto")
    except (OSError, ValueError):
        font = "Roboto"
    colors["font"] = font if isinstance(font, str) and re.fullmatch(r"[A-Za-z0-9 -]{1,80}", font) else "Roboto"
    return colors


def show_window() -> None:
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    from gi.repository import Gdk, GLib, Gtk

    GLib.set_prgname("black-ice-shortcuts")

    class Shortcuts(Gtk.Window):
        def __init__(self):
            super().__init__(title="BLACK-ICE — Atajos de teclado")
            self.set_default_size(980, 620)
            self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
            self.set_position(Gtk.WindowPosition.CENTER)
            self.connect("destroy", Gtk.main_quit)
            self.connect("key-press-event", self.key_press)
            colors = palette()
            css = Gtk.CssProvider()
            css.load_from_data(f"""
                window {{ background:{colors['bg']}; color:{colors['fg']}; }}
                label, entry, button {{ color:{colors['fg']}; font-family:'{colors['font']}'; }}
                .heading {{ font-size:24px; font-weight:600; }}
                .category {{ color:{colors['acc1']}; font-size:14px; font-weight:bold; margin-top:16px; }}
                .key {{ background:alpha({colors['acc1']},.13); border:1px solid alpha({colors['acc1']},.55); border-radius:5px; padding:7px 10px; }}
                .status {{ color:{colors['dim']}; font-size:11px; }}
                entry, button {{ background:alpha({colors['fg']},.06); border:1px solid alpha({colors['fg']},.25); padding:8px; }}
                entry:focus, button:focus {{ border-color:{colors['acc1']}; }}
                list, scrolledwindow, viewport {{ background:{colors['bg']}; }}
                list row {{ background:transparent; padding:5px 0; }}
            """.encode())
            Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin=24)
            self.add(root)
            heading = Gtk.Box(spacing=16)
            title = Gtk.Label(label="Atajos de teclado", xalign=0)
            title.get_style_context().add_class("heading")
            heading.pack_start(title, True, True, 0)
            close = Gtk.Button(label="Cerrar · Esc")
            close.connect("clicked", lambda _button: self.destroy())
            heading.pack_end(close, False, False, 0)
            refresh = Gtk.Button(label="Actualizar")
            refresh.connect("clicked", self.refresh)
            heading.pack_end(refresh, False, False, 0)
            root.pack_start(heading, False, False, 0)
            self.summary = Gtk.Label(xalign=0)
            self.summary.set_line_wrap(True)
            root.pack_start(self.summary, False, False, 0)
            self.search = Gtk.SearchEntry(placeholder_text="Buscar acción, tecla o programa…")
            self.search.connect("search-changed", lambda _entry: self.list.invalidate_filter())
            root.pack_start(self.search, False, False, 0)
            scroll = Gtk.ScrolledWindow()
            scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            root.pack_start(scroll, True, True, 0)
            self.list = Gtk.ListBox()
            self.list.set_selection_mode(Gtk.SelectionMode.NONE)
            self.list.set_filter_func(self.filter_row)
            self.list.set_header_func(self.header)
            scroll.add(self.list)
            foot = Gtk.Label(label="Win es la tecla Windows · F1 o Win+I para abrir · Disponible comprueba programas; no ejecuta acciones.", xalign=0)
            foot.set_line_wrap(True)
            foot.get_style_context().add_class("status")
            root.pack_start(foot, False, False, 0)
            self.refresh()
            self.show_all()
            self.search.grab_focus()
            GLib.timeout_add(150, self.place)

        def place(self):
            try:
                ipc = IPC()
                window = next(c for c in ipc.query("clients") if c["pid"] == os.getpid())
                address = "address:" + window["address"]
                if ipc.lua():
                    ipc.checked("eval hl.dispatch(hl.dsp.window.float({window=" + json.dumps(address) + ',action="set"}))')
                else:
                    ipc.checked("dispatch setfloating " + address)
            except (OSError, ValueError, RuntimeError, StopIteration):
                pass
            return False

        def key_press(self, _widget, event):
            if event.keyval == Gdk.KEY_Escape:
                self.destroy()
                return True
            return False

        def filter_row(self, row):
            return self.search.get_text().casefold() in row.search_text

        def header(self, row, before):
            if before is None or before.category != row.category:
                label = Gtk.Label(label=row.category, xalign=0)
                label.get_style_context().add_class("category")
                row.set_header(label)
            else:
                row.set_header(None)

        def refresh(self, *_args):
            try:
                entries = inventory()
            except (OSError, ValueError, TypeError, RuntimeError) as error:
                self.summary.set_text(f"No se pudo leer Hyprland: {error}. Usa Actualizar para reintentar.")
                return
            for row in self.list.get_children():
                row.destroy()
            for entry in entries:
                row = Gtk.ListBoxRow()
                row.category = entry["category"]
                row.search_text = " ".join(str(v) for v in entry.values()).casefold()
                box = Gtk.Box(spacing=18)
                row.add(box)
                key = Gtk.Label(label=entry["keys"], xalign=0)
                key.set_size_request(230, -1)
                key.set_line_wrap(True)
                key.get_style_context().add_class("key")
                box.pack_start(key, False, False, 0)
                details = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
                action = Gtk.Label(label=entry["action"], xalign=0)
                action.set_line_wrap(True)
                details.pack_start(action, False, False, 0)
                status = Gtk.Label(label=entry["status"] + (" · mapa " + entry["submap"] if entry["submap"] else ""), xalign=0)
                status.set_line_wrap(True)
                status.get_style_context().add_class("status")
                details.pack_start(status, False, False, 0)
                box.pack_start(details, True, True, 0)
                row.set_tooltip_text(entry["command"])
                self.list.add(row)
            missing = sum(bool(entry["missing"]) for entry in entries)
            self.summary.set_text(f"{len(entries)} asignaciones activas · {missing} con programas ausentes · Colores del tema actual")
            self.list.show_all()

    Shortcuts()
    Gtk.main()


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="Imprime asignaciones y dependencias en JSON, sin ejecutar acciones")
    args = parser.parse_args()
    if args.check:
        print(json.dumps(inventory(), ensure_ascii=False, indent=2))
        return 0
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "default")
    if "/" in signature:
        parser.error("Firma de Hyprland no válida")
    with (runtime / f"black-ice-shortcuts-{signature}.lock").open("a+") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            lock.seek(0)
            pid = lock.read().strip()
            if pid.isdigit():
                ipc = IPC()
                for client in ipc.query("clients"):
                    if client["pid"] == int(pid):
                        address = "address:" + client["address"]
                        ipc.checked("eval hl.dispatch(hl.dsp.focus({window=" + json.dumps(address) + "}))" if ipc.lua() else "dispatch focuswindow " + address)
            return 0
        lock.seek(0)
        lock.truncate()
        lock.write(str(os.getpid()))
        lock.flush()
        show_window()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
